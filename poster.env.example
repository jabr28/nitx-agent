# --- Mock backend -------------------------------------------------------------
# tenant:key pairs the mock accepts (comma-separated)
MOCK_API_KEYS=demo:change-me-local-key
MOCK_PORT=8080
MOCK_MIN_SECONDS=5
MOCK_MAX_SECONDS=20
MOCK_FAIL_RATE=0.1
# Force the first N jobs to fail (reproducible demos / evals). 0 = off.
MOCK_FAIL_FIRST_N=0
MOCK_MAX_ACTIVE_JOBS=5

# --- MCP server ---------------------------------------------------------------
# Credentials are read from the environment only, never from tool arguments.
POSTER_API_KEY=change-me-local-key
POSTER_API_BASE_URL=http://127.0.0.1:8080
POSTER_API_TIMEOUT_SECONDS=10
POSTER_API_MAX_RETRIES=2
POSTER_MAX_IMAGES_PER_HOUR=40
LOG_LEVEL=INFO
